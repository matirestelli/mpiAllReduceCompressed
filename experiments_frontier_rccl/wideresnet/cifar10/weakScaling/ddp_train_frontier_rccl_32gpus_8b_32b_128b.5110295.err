+ WARMUP_EPOCHS=0
+ export NUM_WORKERS=6
+ NUM_WORKERS=6
+ export PIN_MEMORY=true
+ PIN_MEMORY=true
+ export DROP_LAST=true
+ DROP_LAST=true
+ export PRETRAINED=false
+ PRETRAINED=false
+ export OPTIMIZER=sgd
+ OPTIMIZER=sgd
+ export CIFAR_STEM=true
+ CIFAR_STEM=true
+ export INIT_CIFAR_STEM_FROM_PRETRAINED_CENTER=false
+ INIT_CIFAR_STEM_FROM_PRETRAINED_CENTER=false
+ export DATA_DIR=./data
+ DATA_DIR=./data
+ export CHECKPOINT_DIR=./checkpoints
+ CHECKPOINT_DIR=./checkpoints
+ export SEED=42
+ SEED=42
+ export BACKEND=nccl
+ BACKEND=nccl
+ export COMM_ALGORITHM=ring_zfp_online_coll
+ COMM_ALGORITHM=ring_zfp_online_coll
+ unset MIOPEN_FIND_MODE
+ unset MIOPEN_FIND_ENFORCE
+ export TORCH_DISTRIBUTED_DEBUG=OFF
+ TORCH_DISTRIBUTED_DEBUG=OFF
+ export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
+ TORCH_NCCL_ASYNC_ERROR_HANDLING=1
+ [[ -n 8 ]]
+ export ZFP_RATE=8
+ ZFP_RATE=8
+ unset SRUN_CPUS_PER_TASK
+ unset HIP_VISIBLE_DEVICES CUDA_VISIBLE_DEVICES
+ echo MIOPEN_USER_DB_PATH=/mnt/bb/matilderestelli/miopen_cache_5110295/miopen_db
+ echo MIOPEN_CUSTOM_CACHE_DIR=/mnt/bb/matilderestelli/miopen_cache_5110295/kernel_cache
+ '[' -n /mnt/bb/matilderestelli/miopen_cache_5110295/miopen_db ']'
+ ls -ld /mnt/bb/matilderestelli/miopen_cache_5110295/miopen_db
+ echo '==== GPU visibility debug (batch shell) ===='
+ hostname
+ env
+ egrep 'ROCR_VISIBLE_DEVICES|HIP_VISIBLE_DEVICES|CUDA_VISIBLE_DEVICES|GPU_DEVICE_ORDINAL|SLURM_JOB_GPUS|SLURM_STEP_GPUS'
+ command -v rocminfo
+ head -n 30
+ rocminfo
+ true
